rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function isAllowed() {
      return signedIn()
        && exists(/databases/$(database)/documents/allowedUsers/$(emailKey()));
    }

    // Must match VITE_BOOTSTRAP_ALLOWLIST in .env.local.
    function isBootstrapEmail() {
      return emailKey() in ['ethan.lee@unbounded.org'];
    }

    // Pass the path wildcard in — helpers outside the match block cannot see it.
    function isAllowedUserDoc(docEmail) {
      return request.resource.data.keys().hasOnly([
          'email', 'displayName', 'grantedBy', 'grantedAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.email == docEmail
        && (request.resource.data.displayName == null
            || request.resource.data.displayName is string)
        && (request.resource.data.grantedBy == null
            || request.resource.data.grantedBy is string)
        && (request.resource.data.grantedAt is int
            || request.resource.data.grantedAt is float);
    }

    match /allowedUsers/{email} {
      allow get: if signedIn() && (email == emailKey() || isAllowed());
      allow list: if isAllowed();

      allow create: if isAllowedUserDoc(email) && (
        isAllowed()
        || (isBootstrapEmail() && request.resource.data.grantedBy == null)
      );
      allow update: if isAllowed() && isAllowedUserDoc(email);
      allow delete: if isAllowed() && email != emailKey();
    }

    match /facilitators/{doc} {
      allow read, write: if isAllowed();
    }

    match /headshots/{doc} {
      allow read, write: if isAllowed();
    }

    // Shared email templates — any allowlisted user can read/write.
    match /emailTemplates/{templateId} {
      function isValidTemplate() {
        return request.resource.data.keys().hasOnly([
            'id', 'name', 'purpose', 'subject', 'body',
            'createdByUid', 'createdByEmail',
            'updatedByUid', 'updatedByEmail',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.id == templateId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.purpose is string
          && request.resource.data.purpose.size() <= 500
          && request.resource.data.subject is string
          && request.resource.data.subject.size() <= 300
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 20000
          && request.resource.data.createdByUid is string
          && request.resource.data.createdByEmail is string
          && request.resource.data.updatedByUid is string
          && request.resource.data.updatedByEmail is string
          && (request.resource.data.createdAt is int
              || request.resource.data.createdAt is float)
          && (request.resource.data.updatedAt is int
              || request.resource.data.updatedAt is float);
      }

      allow read: if isAllowed();
      allow create, update: if isAllowed() && isValidTemplate();
      allow delete: if isAllowed();
    }

    // Shared booking events / placements — any allowlisted user can read/write.
    match /events/{eventId} {
      function isValidEvent() {
        return request.resource.data.keys().hasOnly([
            'id', 'accountSchool', 'eventType', 'eventMode',
            'startDate', 'endDate', 'startTime', 'endTime', 'stage',
            'notes', 'pathways', 'sections', 'placements', 'status',
            'createdByUid', 'createdByEmail',
            'updatedByUid', 'updatedByEmail',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.id == eventId
          && request.resource.data.accountSchool is string
          && request.resource.data.accountSchool.size() > 0
          && request.resource.data.accountSchool.size() <= 200
          && request.resource.data.eventType in [
            'Executive Coaching', 'GLEAM Learning Walk', 'In Service Workshop',
            'Standards Institute', 'Summit', 'Custom'
          ]
          && request.resource.data.eventMode in ['In-Person', 'Virtual']
          && request.resource.data.startDate is string
          && request.resource.data.startDate.size() <= 40
          && request.resource.data.endDate is string
          && request.resource.data.endDate.size() <= 40
          && request.resource.data.startTime is string
          && request.resource.data.startTime.size() <= 16
          && request.resource.data.endTime is string
          && request.resource.data.endTime.size() <= 16
          && request.resource.data.stage in [
            'prospective', 'likely', 'contracted', 'delivered'
          ]
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 2000
          && request.resource.data.pathways is list
          && request.resource.data.pathways.size() <= 50
          && request.resource.data.sections is list
          && request.resource.data.sections.size() <= 200
          && request.resource.data.placements is list
          && request.resource.data.placements.size() <= 500
          && request.resource.data.status in ['active', 'archived']
          && request.resource.data.createdByUid is string
          && request.resource.data.createdByEmail is string
          && request.resource.data.updatedByUid is string
          && request.resource.data.updatedByEmail is string
          && (request.resource.data.createdAt is int
              || request.resource.data.createdAt is float)
          && (request.resource.data.updatedAt is int
              || request.resource.data.updatedAt is float);
      }

      allow read: if isAllowed();
      allow create, update: if isAllowed() && isValidEvent();
      allow delete: if isAllowed();
    }

    // Personal facilitator groups — owner-only, still require allowlist.
    match /groups/{groupId} {
      function isGroupOwner() {
        return resource.data.ownerUid == request.auth.uid;
      }

      function isValidGroup() {
        return request.resource.data.keys().hasOnly([
            'id', 'name', 'description', 'ownerUid', 'ownerEmail',
            'facilitatorIds', 'status', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.id == groupId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerEmail is string
          && request.resource.data.facilitatorIds is list
          && request.resource.data.status in ['active', 'archived']
          && (request.resource.data.createdAt is int
              || request.resource.data.createdAt is float)
          && (request.resource.data.updatedAt is int
              || request.resource.data.updatedAt is float);
      }

      allow read, delete: if isAllowed() && isGroupOwner();
      allow create: if isAllowed() && isValidGroup();
      allow update: if isAllowed()
        && isGroupOwner()
        && isValidGroup()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
