# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values, then restart `npm run dev`.
# `.env.local` is git-ignored so your keys never get committed.
#
# WHERE THESE COME FROM — see SETUP-GOOGLE-SHEETS.md for click-by-click steps.
# ---------------------------------------------------------------------------

# --- Firebase (Project settings -> General -> Your apps -> Web app config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated emails allowed to seed the allowlist on first sign-in.
# Mirror the same addresses in firestore.rules → isBootstrapEmail().
# Example: VITE_BOOTSTRAP_ALLOWLIST=you@unbounded.org,colleague@unbounded.org
VITE_BOOTSTRAP_ALLOWLIST=

# --- Google Cloud (same project as Firebase) ---
# OAuth 2.0 Client ID (Web application) used to request the Sheets/Drive scope.
VITE_GOOGLE_CLIENT_ID=
# API key restricted to the Google Picker API (and Sheets API).
VITE_GOOGLE_API_KEY=
